#include <stdio.h>

#define MAX 100

int graph[MAX][MAX];
int visited[MAX];
int stack[MAX];
int top = -1;

void DFS(int u, int n) {

    visited[u] = 1;

    for (int v = 0; v < n; v++) {

        if (graph[u][v] &&
            !visited[v]) {

            DFS(v, n);
        }
    }

    /* Push after DFS finishes */
    stack[++top] = u;
}

int main() {

    int n;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    for (int i = 0; i < n; i++)
        visited[i] = 0;

    for (int i = 0; i < n; i++)
        if (!visited[i])
            DFS(i, n);

    printf("Stack based on finish time:\n");

    while (top >= 0)
        printf("%d ", stack[top--]);

    return 0;
}
