#include <stdio.h>

int linearSearch(int arr[], int n, int key)
{
    int i;

    for (i = 0; i < n; i++)
    {
        if (arr[i] == key)
            return i;
    }

    return -1;
}

int binarySearch(int arr[], int n, int key)
{
    int low = 0, high = n - 1, mid;

    while (low <= high)
    {
        mid = (low + high) / 2;

        if (arr[mid] == key)
            return mid;

        if (arr[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    return -1;
}

int main()
{
    int arr[100], n, key;
    int sorted, result;

    printf("Enter size: ");
    scanf("%d", &n);

    printf("Enter elements: ");

    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    printf("Is array sorted? (1-Yes, 0-No): ");
    scanf("%d", &sorted);

    printf("Enter key: ");
    scanf("%d", &key);

    if (sorted && n > 5)
        result = binarySearch(arr, n, key);
    else
        result = linearSearch(arr, n, key);

    if (result == -1)
        printf("Not Found\n");
    else
        printf("Found at index %d\n", result);

    return 0;
}
