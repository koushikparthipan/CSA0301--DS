#include <stdio.h>

#define MAX 20
#define INF 99999

int main() {
    int n, h;
    int graph[MAX][MAX];
    int hubs[MAX];

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix (99999 for infinity):\n");

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    printf("Enter number of hub nodes: ");
    scanf("%d", &h);

    printf("Enter hub nodes: ");
    for (int i = 0; i < h; i++)
        scanf("%d", &hubs[i]);

    for (int x = 0; x < h; x++) {
        int k = hubs[x];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (graph[i][k] != INF &&
                    graph[k][j] != INF &&
                    graph[i][k] + graph[k][j] < graph[i][j]) {

                    graph[i][j] =
                        graph[i][k] + graph[k][j];
                }
            }
        }
    }

    printf("\nShortest Path Matrix:\n");

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++)
            printf("%d ", graph[i][j]);

        printf("\n");
    }

    return 0;
}
