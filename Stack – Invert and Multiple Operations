#include <stdio.h>
#define MAX 10

int stack[MAX] = {22,55,33,66,88};
int top = 4;

void push(int x)
{
    if (top == MAX-1)
        printf("Overflow\n");
    else
        stack[++top] = x;
}

void pop()
{
    if (top == -1)
        printf("Underflow\n");
    else
        top--;
}

void invert()
{
    int i, temp;

    for (i = 0; i <= top / 2; i++)
    {
        temp = stack[i];
        stack[i] = stack[top-i];
        stack[top-i] = temp;
    }
}

void display()
{
    int i;

    for (i = top; i >= 0; i--)
        printf("%d ", stack[i]);

    printf("\n");
}

int main()
{
    invert();

    pop();
    pop();
    pop();

    push(90);
    push(36);
    push(11);
    push(88);

    pop();
    pop();

    printf("Final Stack: ");
    display();

    return 0;
}
