#include <stdio.h>
#define MAX 5

int queue[MAX];
int front = -1, rear = -1;

void enqueue(int x)
{
    if (rear == MAX-1)
    {
        printf("Overflow\n");
        return;
    }

    if (front == -1)
        front = 0;

    queue[++rear] = x;
}

void dequeue()
{
    if (front == -1 || front > rear)
    {
        printf("Underflow\n");
        return;
    }

    printf("Deleted = %d\n", queue[front++]);

    if (front > rear)
        front = rear = -1;
}

int main()
{
    enqueue(21);
    enqueue(67);
    enqueue(89);

    dequeue();

    enqueue(15);
    enqueue(30);

    dequeue();

    enqueue(52);

    dequeue();
    dequeue();
    dequeue();

    return 0;
}
