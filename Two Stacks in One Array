#include <stdio.h>
#define MAX 10

int arr[MAX];

int top1 = -1;
int top2 = MAX;

void push1(int x)
{
    if (top1 + 1 == top2)
    {
        printf("Overflow\n");
        return;
    }

    arr[++top1] = x;
}

void push2(int x)
{
    if (top1 + 1 == top2)
    {
        printf("Overflow\n");
        return;
    }

    arr[--top2] = x;
}

void pop1()
{
    if (top1 == -1)
        printf("Stack 1 Empty\n");
    else
        printf("Pop1 = %d\n", arr[top1--]);
}

void pop2()
{
    if (top2 == MAX)
        printf("Stack 2 Empty\n");
    else
        printf("Pop2 = %d\n", arr[top2++]);
}

int main()
{
    push1(10);
    push1(20);

    push2(100);
    push2(200);

    pop1();
    pop2();

    return 0;
}
