#include <stdio.h>

#define MAX 100

int main() {

    int n, graph[MAX][MAX];
    int visited[MAX] = {0};
    int distance[MAX];

    int queue[MAX];
    int front = 0, rear = 0;

    int source;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    scanf("%d", &source);

    for (int i = 0; i < n; i++)
        distance[i] = -1;

    queue[rear++] = source;
    visited[source] = 1;
    distance[source] = 0;

    while (front < rear) {

        int u = queue[front++];

        if (distance[u] == 3)
            continue;

        for (int v = 0; v < n; v++) {

            if (graph[u][v] &&
                !visited[v]) {

                visited[v] = 1;

                distance[v] =
                    distance[u] + 1;

                queue[rear++] = v;
            }
        }
    }

    printf("Users exactly 3 degrees away:\n");

    for (int i = 0; i < n; i++)
        if (distance[i] == 3)
            printf("%d ", i);

    return 0;
}
