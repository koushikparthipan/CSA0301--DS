#include <stdio.h>

#define MAX 20
#define INF 999999

int main() {
    int n, graph[MAX][MAX], penalty[MAX];
    int dist[MAX], visited[MAX] = {0};
    int source;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    printf("Enter penalties:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &penalty[i]);

    printf("Enter source: ");
    scanf("%d", &source);

    for (int i = 0; i < n; i++)
        dist[i] = INF;

    dist[source] = penalty[source];

    for (int k = 0; k < n; k++) {
        int u = -1;

        for (int i = 0; i < n; i++)
            if (!visited[i] &&
                (u == -1 || dist[i] < dist[u]))
                u = i;

        if (u == -1)
            break;

        visited[u] = 1;

        for (int v = 0; v < n; v++) {
            if (graph[u][v] > 0) {
                int cost =
                    dist[u] +
                    graph[u][v] +
                    penalty[v];

                if (cost < dist[v])
                    dist[v] = cost;
            }
        }
    }

    for (int i = 0; i < n; i++)
        printf("%d -> %d = %d\n",
               source, i, dist[i]);

    return 0;
}
