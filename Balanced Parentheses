#include <stdio.h>

char stack[100];
int top = -1;

void push(char x)
{
    stack[++top] = x;
}

char pop()
{
    return stack[top--];
}

int match(char open, char close)
{
    return (open == '(' && close == ')') ||
           (open == '[' && close == ']') ||
           (open == '{' && close == '}');
}

int main()
{
    char exp[100];
    int i, valid = 1;

    printf("Enter expression: ");
    scanf("%s", exp);

    for (i = 0; exp[i] != '\0'; i++)
    {
        if (exp[i] == '(' ||
            exp[i] == '[' ||
            exp[i] == '{')
        {
            push(exp[i]);
        }
        else if (exp[i] == ')' ||
                 exp[i] == ']' ||
                 exp[i] == '}')
        {
            if (top == -1 ||
                !match(pop(), exp[i]))
            {
                valid = 0;
                break;
            }
        }
    }

    if (top != -1)
        valid = 0;

    if (valid)
        printf("Balanced\n");
    else
        printf("Not Balanced\n");

    return 0;
}
