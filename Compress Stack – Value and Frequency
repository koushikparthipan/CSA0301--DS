#include <stdio.h>

int main()
{
    int stack[] = {10,10,10,20,20,30};
    int n = 6;
    int i, count;

    printf("Value  Frequency\n");

    for (i = 0; i < n; i++)
    {
        if (i > 0 && stack[i] == stack[i-1])
            continue;

        count = 1;

        while (i + count < n &&
               stack[i] == stack[i + count])
        {
            count++;
        }

        printf("%d       %d\n", stack[i], count);
    }

    return 0;
}
